{
  "name": "mossgate",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "assets:generate": "tsx scripts/generate-assets.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:smoke": "vitest run tests/smoke",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:runtime",
    "test:production": "npm run build && playwright test --config playwright.production.config.ts",
    "typecheck": "tsc -p tsconfig.domain.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.tooling.json",
    "check:runtime": "npm test && npm run test:smoke && npm run build && npm run test:e2e && npm run test:production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
